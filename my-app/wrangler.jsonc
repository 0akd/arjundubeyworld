{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-29",
  // Public database URL. Replace the placeholder with your Turso URL.
  // Set the token separately: npx wrangler secret put TURSO_AUTH_TOKEN
  "vars": {
    "TURSO_DATABASE_URL": "libsql://blog-arjundubey.aws-eu-west-1.turso.io"
  }
